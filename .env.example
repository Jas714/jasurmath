# Anthropic API kaliti - https://console.anthropic.com dan olinadi
ANTHROPIC_API_KEY=sk-ant-...

# @BotFather bergan bot tokeni. Telegram initData ni tekshirish uchun kerak.
# Ishlab chiqish (dev) rejimida bo'sh qoldirsa ham ishlaydi, productionda MAJBURIY.
TELEGRAM_BOT_TOKEN=

# Ixtiyoriy. Modelni almashtirish (default: claude-opus-5).
# Arzonroq sinov uchun: claude-sonnet-5 yoki claude-haiku-4-5
ANTHROPIC_MODEL=

# Ixtiyoriy. O'ylash chuqurligi: low | medium | high (default: medium).
# Faqat yangi modellarda ishlaydi (opus-5, sonnet-5, ...).
ANTHROPIC_EFFORT=

# Ochiq API (/api/solve) uchun kalit. Bo'sh qoldirilsa faqat kalitsiz
# rejim ishlaydi (soatiga 3 so'rov). Kalit bilan - soatiga 100 so'rov.
PUBLIC_API_KEY=

# Ochiq API uchun alohida model (ixtiyoriy). Bo'sh bo'lsa ANTHROPIC_MODEL,
# u ham bo'sh bo'lsa claude-opus-5 ishlatiladi.
PUBLIC_API_MODEL=
